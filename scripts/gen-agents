#!/usr/bin/env bash
# desc: generate Claude Code + Codex agent files from agents/ and company/agents/
# Usage: gen-agents [--check] [--dry-run] [--out DIR]
#
# Reads canonical agents/<name>.md and company/agents/<name>.md (frontmatter:
# name, description, tier, tools, output) and writes:
#   ~/.claude/agents/<name>.md    (tier -> model via models.md)
#   ~/.codex/agents/<name>.toml   (tier -> model + reasoning effort)
# Only for tools whose base dir (~/.claude, ~/.codex) exists.
# --out DIR writes to DIR/claude and DIR/codex instead (for testing).
# Files without frontmatter (e.g. delegation.md) are skipped. Generated files
# carry a marker; files without it are backed up, never overwritten. Stale
# generated files whose source is gone are removed.
set -euo pipefail
. "$(dirname "$0")/lib/common.sh"

CHECK=0; DRY_RUN=0; OUT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --out) OUT="${2:?--out needs a dir}"; shift ;;
    -h|--help) usage_from_header "$0"; exit 0 ;;
    *) die "unknown flag: $1 (see --help)" ;;
  esac
  shift
done
export CHECK DRY_RUN

MARKER="generated by 0a-ancestor/scripts/gen-agents"
MODELS="$ANCESTOR/models.md"
[ -f "$MODELS" ] || die "models.md not found"

# model_col TIER COL -> value from the models.md table (COL: 2=claude 3=codex 4=codex_effort)
model_col() {
  awk -F'|' -v t="$1" -v c="$2" '
    { tier=$2; gsub(/[ \t]/, "", tier) }
    tier==t { v=$(c+1); gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit }' "$MODELS"
}

# fm FILE KEY -> frontmatter value (quotes stripped); empty if absent.
fm() {
  awk -v k="$2" '
    NR==1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    index($0, k ":") == 1 { v=substr($0, length(k)+2); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (v ~ /^".*"$/ || v ~ /^\x27.*\x27$/) v=substr(v, 2, length(v)-2); print v; exit }' "$1"
}

body() { awk 'NR==1 && $0=="---" {f=1; next} f==1 && $0=="---" {f=2; next} f==2 {print}' "$1"; }

# esc STRING -> escaped for a double-quoted YAML/TOML string.
esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

claude_tools() {
  local caps="$1" out="" c
  for c in $(printf '%s' "$caps" | tr ',' ' '); do
    case "$c" in
      read)  out="$out, Read, Grep, Glob" ;;
      write) out="$out, Edit, Write" ;;
      shell) out="$out, Bash" ;;
      web)   out="$out, WebFetch, WebSearch" ;;
      mcp)   printf ''; return 0 ;;   # no restriction: inherit all tools incl. MCP
      *) die "unknown tool capability '$c' (use read, write, shell, web, mcp)" ;;
    esac
  done
  printf '%s' "${out#, }"
}

codex_sandbox() {
  case ",$(printf '%s' "$1" | tr -d ' ')," in
    *,write,*) printf 'workspace-write' ;;
    *) printf 'read-only' ;;
  esac
}

render_claude() { # file name desc tier tools output
  local tools; tools="$(claude_tools "$5")"
  printf -- '---\nname: %s\ndescription: "%s"\n' "$2" "$(esc "$3")"
  [ -n "$tools" ] && printf 'tools: %s\n' "$tools"
  printf 'model: %s\n---\n' "$(model_col "$4" 2)"
  printf '<!-- %s from %s; edit that file, then re-run gen-agents -->\n' "$MARKER" "${1#"$ANCESTOR"/}"
  body "$1"
  [ -n "$6" ] && printf '\nOutput contract: %s\n' "$6"
  return 0
}

render_codex() { # file name desc tier tools output
  local b; b="$(body "$1")"
  case "$b" in *"'''"*) die "$1: body contains ''' which TOML literal strings can't hold" ;; esac
  printf '# %s from %s; edit that file, then re-run gen-agents\n' "$MARKER" "${1#"$ANCESTOR"/}"
  printf 'name = "%s"\ndescription = "%s"\n' "$2" "$(esc "$3")"
  printf 'model = "%s"\nmodel_reasoning_effort = "%s"\n' "$(model_col "$4" 3)" "$(model_col "$4" 4)"
  printf 'sandbox_mode = "%s"\n' "$(codex_sandbox "$5")"
  printf "developer_instructions = '''\n%s\n" "$b"
  [ -n "$6" ] && printf '\nOutput contract: %s\n' "$6"
  printf "'''\n"
}

# Targets: "kind:dir"
targets=""
if [ -n "$OUT" ]; then
  targets="claude:$OUT/claude codex:$OUT/codex"
else
  [ -d "$HOME/.claude" ] && targets="$targets claude:$HOME/.claude/agents"
  [ -d "$HOME/.codex" ] && targets="$targets codex:$HOME/.codex/agents"
fi
if [ -z "${targets// /}" ]; then
  warn "no ~/.claude or ~/.codex dir found; nothing to generate"; exit 0
fi

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
names=" "; n_written=0; n_same=0; n_bad=0

for f in "$ANCESTOR"/agents/*.md "$ANCESTOR"/company/agents/*.md; do
  [ -f "$f" ] || continue
  name="$(fm "$f" name)"
  [ -n "$name" ] || continue            # not an agent (no frontmatter), e.g. delegation.md
  desc="$(fm "$f" description)"; tier="$(fm "$f" tier)"; tools="$(fm "$f" tools)"; output="$(fm "$f" output)"
  rel="${f#"$ANCESTOR"/}"
  if [ "$name.md" != "$(basename "$f")" ]; then err "$rel: name '$name' doesn't match filename"; n_bad=$((n_bad+1)); continue; fi
  if [ -z "$desc" ] || [ -z "$tier" ] || [ -z "$tools" ]; then err "$rel: needs description, tier and tools"; n_bad=$((n_bad+1)); continue; fi
  if [ -z "$(model_col "$tier" 2)" ]; then err "$rel: tier '$tier' not in models.md"; n_bad=$((n_bad+1)); continue; fi
  case "$names" in *" $name "*) warn "$rel: duplicate agent name '$name' — skipped"; continue ;; esac
  names="$names$name "

  for t in $targets; do
    kind="${t%%:*}"; dir="${t#*:}"
    if [ "$kind" = claude ]; then ext=md; else ext=toml; fi
    dst="$dir/$name.$ext"; new="$tmp/$kind-$name.$ext"
    "render_$kind" "$f" "$name" "$desc" "$tier" "$tools" "$output" > "$new"
    if [ -f "$dst" ] && cmp -s "$new" "$dst"; then n_same=$((n_same+1)); continue; fi
    if [ "$CHECK" = 1 ]; then err "out of date: $dst"; N_PROBLEMS=$((N_PROBLEMS+1)); continue; fi
    if [ -e "$dst" ] && ! grep -q "$MARKER" "$dst"; then backup "$dst"; fi
    run mkdir -p "$dir"
    if [ "$DRY_RUN" = 1 ]; then dim "would write $dst"; else cp "$new" "$dst"; ok "wrote $dst"; fi
    n_written=$((n_written+1))
  done
done

# Remove stale generated files.
for t in $targets; do
  dir="${t#*:}"; [ -d "$dir" ] || continue
  for g in "$dir"/*.md "$dir"/*.toml; do
    [ -f "$g" ] || continue
    grep -q "$MARKER" "$g" || continue
    n="$(basename "$g")"; n="${n%.*}"
    case "$names" in *" $n "*) continue ;; esac
    if [ "$CHECK" = 1 ]; then err "stale: $g"; N_PROBLEMS=$((N_PROBLEMS+1))
    else run rm "$g"; ok "removed stale $g"; fi
  done
done

[ "$n_bad" -gt 0 ] && die "$n_bad invalid agent file(s)"
if [ "$CHECK" = 1 ]; then
  [ "$N_PROBLEMS" = 0 ] && ok "agents: all up to date ($n_same files)"
  exit $((N_PROBLEMS > 0))
fi
dim "agents: written $n_written · unchanged $n_same · backed up $N_BACKED"
