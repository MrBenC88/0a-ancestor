#!/usr/bin/env bash
# desc: write $DEV_DIR/REPOS.md: one row per repo (branch, stack, purpose)
# Usage: index-repos [--check] [--dry-run] [--stdout]
#
# Agents read REPOS.md before exploring. Purpose comes from the first prose
# line of the repo's README, else AGENTS.md. Local data only, no network.
set -euo pipefail
. "$(dirname "$0")/lib/common.sh"

CHECK=0; DRY_RUN=0; STDOUT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --stdout) STDOUT=1 ;;
    -h|--help) usage_from_header "$0"; exit 0 ;;
    *) die "unknown flag: $1 (see --help)" ;;
  esac
  shift
done

# purpose FILE -> first prose line (skips headings, badges, comments, blanks), <= 100 chars.
purpose() {
  [ -f "$1" ] || return 0
  awk '
    /^[[:space:]]*$/ || /^#/ || /^</ || /^!\[/ || /^\[!\[/ || /^---/ || /^@/ || /^```/ || /^\|/ { next }
    { gsub(/\|/, "/"); print substr($0, 1, 100); exit }' "$1"
}

marker="<!-- generated by 0a-ancestor/scripts/index-repos; re-run it to refresh, don't edit -->"
out="$(mktemp)"; trap 'rm -f "$out"' EXIT
count=0
{
  printf '%s\n# Repos in %s\n\n' "$marker" "$(basename "$DEV_DIR")"
  printf '| Repo | Default branch | Stack | Purpose |\n| --- | --- | --- | --- |\n'
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    count=$((count+1))
    p="$(purpose "$r/README.md")"
    [ -n "$p" ] || p="$(purpose "$r/AGENTS.md")"
    printf '| %s | %s | %s | %s |\n' "$(basename "$r")" "$(default_branch "$r")" "$(detect_stack "$r")" "${p:--}"
  done <<EOF
$(list_repos all)
EOF
  printf '\nPer-repo rules: `<repo>/AGENTS.md`. Global rules: `AGENTS.md` here.\n'
} > "$out"

dst="$DEV_DIR/REPOS.md"
if [ "$STDOUT" = 1 ]; then cat "$out"; exit 0; fi
if [ -f "$dst" ] && cmp -s "$out" "$dst"; then
  [ "$CHECK" = 1 ] && ok "REPOS.md up to date"
  exit 0
fi
if [ "$CHECK" = 1 ]; then err "REPOS.md missing or out of date (run index-repos)"; exit 1; fi
if [ -f "$dst" ] && ! grep -qF "generated by 0a-ancestor/scripts/index-repos" "$dst"; then
  [ "$DRY_RUN" = 1 ] || backup "$dst"
fi
if [ "$DRY_RUN" = 1 ]; then dim "would write $dst"; exit 0; fi
cp "$out" "$dst"
ok "wrote $dst ($count repos)"
